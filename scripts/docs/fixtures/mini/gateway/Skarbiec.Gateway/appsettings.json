{
  "ReverseProxy": {
    "Routes": {
      "identity-login": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/identity/login/{**catch-all}" }
      },
      "portfolio-protected": {
        "ClusterId": "portfolio-cluster",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "standard",
        "Match": { "Path": "/api/portfolio/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": { "d1": { "Address": "https+http://identity-service" } }
      },
      "portfolio-cluster": {
        "Destinations": { "d1": { "Address": "https+http://portfolio-service" } }
      }
    }
  }
}
