<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>778d9a52-eb07-4397-b80d-70907ad0363f</UserSecretsId>
    <!-- Aspire 13.6.5 warns on its own default AspireUseCliBundle=false; the AppHost runs via dotnet run, not the Aspire CLI. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\services\Identity\Skarbiec.Identity\Skarbiec.Identity.csproj" />
    <ProjectReference Include="..\services\Portfolio\Skarbiec.Portfolio\Skarbiec.Portfolio.csproj" />
    <ProjectReference Include="..\services\MarketData\Skarbiec.MarketData\Skarbiec.MarketData.csproj" />
    <ProjectReference Include="..\services\Reporting\Skarbiec.Reporting\Skarbiec.Reporting.csproj" />
    <ProjectReference Include="..\gateway\Skarbiec.Gateway\Skarbiec.Gateway.csproj" />
  </ItemGroup>

</Project>
