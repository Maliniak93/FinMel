{
  "name": "skarbiec-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "gen:api": "openapi-ts",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "lint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.{scss,css}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.9",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.6.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "material-symbols": "^0.48.3",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
