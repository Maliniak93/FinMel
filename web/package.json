{
  "name": "skarbiec-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "gen:api": "openapi-ts",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.2.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "tsx": "4.23.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
