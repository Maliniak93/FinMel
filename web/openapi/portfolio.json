  "components": {
    "schemas": {
      "AddAssetRequest": {
        "required": [
          "assetClass",
          "name"
        ],
        "type": "object",
        "properties": {
          "assetClass": {
            "$ref": "#/components/schemas/AssetClass"
          },
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "instrumentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "manualValue": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "manualValueDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "initialTransaction": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RecordTransactionRequest"
              }
            ]
          }
        }
      },
      "AddDepositRequest": {
        "required": [
          "name",
          "currency",
          "principal",
          "startDate",
          "termLength",
          "termUnit",
          "annualInterestRatePercent",
          "capitalization"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "bankName": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ]
          },
          "currency": {
            "type": "string"
          },
          "principal": {
            "maximum": 79228162514264337593543950335,
            "exclusiveMinimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "termLength": {
            "maximum": 3650,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "termUnit": {
            "$ref": "#/components/schemas/DepositTermUnit"
          },
          "annualInterestRatePercent": {
            "maximum": 100,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "capitalization": {
            "$ref": "#/components/schemas/DepositCapitalization"
          },
          "taxExempt": {
            "type": "boolean"
          },
          "earlyBreakInterestLossPercent": {
            "maximum": 100,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "AssetClass": {
        "type": "integer"
      },
      "AssetResponse": {
        "required": [
          "id",
          "portfolioId",
          "assetClass",
          "valuationMode",
          "name",
          "currency",
          "quantity",
          "transactionCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "portfolioId": {
            "type": "string",
            "format": "uuid"
          },
          "assetClass": {
            "$ref": "#/components/schemas/AssetClass"
          },
          "valuationMode": {
            "$ref": "#/components/schemas/AssetValuationMode"
          },
          "name": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "manualValue": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "manualValueDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "instrumentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "transactionCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "depositMaturityDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "AssetValuationMode": {
        "type": "integer"
      },
      "CreatePortfolioRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "type": [
              "null",
              "string"
            ]
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "DepositCapitalization": {
        "type": "integer"
      },
      "DepositProjectionResponse": {
        "required": [
          "grossInterest",
          "tax",
          "netInterest",
          "finalAmount",
          "netProfitPercent"
        ],
        "type": "object",
        "properties": {
          "grossInterest": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "tax": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "netInterest": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "finalAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "netProfitPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "DepositResponse": {
        "required": [
          "assetId",
          "portfolioId",
          "portfolioName",
          "portfolioIsArchived",
          "name",
          "currency",
          "principal",
          "startDate",
          "termLength",
          "termUnit",
          "maturityDate",
          "annualInterestRatePercent",
          "capitalization",
          "taxExempt",
          "earlyBreakInterestLossPercent",
          "projection",
          "status"
        ],
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "portfolioId": {
            "type": "string",
            "format": "uuid"
          },
          "portfolioName": {
            "type": "string"
          },
          "portfolioIsArchived": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "bankName": {
            "type": [
              "null",
              "string"
            ]
          },
          "currency": {
            "type": "string"
