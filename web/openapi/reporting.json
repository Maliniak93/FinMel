          "assetClass": {
            "$ref": "#/components/schemas/AssetClass"
          },
          "valuePln": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
