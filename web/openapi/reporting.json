{
  "openapi": "3.1.1",
  "info": {
    "title": "Skarbiec.Reporting | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/reporting/dashboard": {
      "get": {
        "tags": [
          "GetDashboardEndpoint"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/reporting/net-worth-history": {
      "get": {
        "tags": [
          "GetNetWorthHistoryEndpoint"
        ],
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "1Y"
            }
          },
          {
            "name": "assetClass",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/AssetClass"
            }
          },
          {
            "name": "groupId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ungrouped",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetWorthHistoryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/reporting/target-allocation": {
      "get": {
        "tags": [
          "GetTargetAllocationEndpoint"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetAllocationResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "SaveTargetAllocationEndpoint"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveTargetAllocationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/reporting/target-allocation/groups/{groupId}": {
      "get": {
        "tags": [
          "GetGroupTargetAllocationEndpoint"
        ],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetAllocationResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "SaveGroupTargetAllocationEndpoint"
        ],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveTargetAllocationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      },
      "delete": {
        "tags": [
          "DeleteGroupTargetAllocationEndpoint"
        ],
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
