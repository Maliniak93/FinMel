{
  "openapi": "3.1.1",
  "info": {
    "title": "Skarbiec.MarketData | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/marketdata/instruments/search": {
      "get": {
        "tags": [
          "SearchInstrumentsEndpoint"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InstrumentSearchResult"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/marketdata/instruments": {
      "post": {
        "tags": [
          "AddCustomInstrumentEndpoint"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddCustomInstrumentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomInstrumentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/marketdata/instruments/{id}": {
      "get": {
        "tags": [
          "GetInstrumentEndpoint"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/marketdata/sync/trigger": {
      "post": {
        "tags": [
          "TriggerSyncEndpoint"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/marketdata/sync/status": {
      "get": {
        "tags": [
          "GetSyncStatusEndpoint"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/marketdata/bond-series": {
      "get": {
        "tags": [
          "ListBondSeriesEndpoint"
        ],
        "parameters": [
          {
            "name": "onSaleOn",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BondSeriesListItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/marketdata/bond-series/{code}": {
      "get": {
        "tags": [
          "GetBondSeriesEndpoint"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BondSeriesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/marketdata/metal-prices": {
      "get": {
        "tags": [
          "GetMetalPricesEndpoint"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MetalPriceResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddCustomInstrumentRequest": {
        "required": [
          "ticker",
          "name",
          "quoteCurrency",
          "assetClass"
        ],
        "type": "object",
        "properties": {
          "ticker": {
            "maxLength": 30,
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "quoteCurrency": {
            "maxLength": 3,
            "minLength": 3,
            "type": "string"
          },
          "assetClass": {
            "$ref": "#/components/schemas/AssetClass"
          },
          "allowUnverified": {
            "type": "boolean"
          }
        }
      },
      "AssetClass": {
        "type": "integer"
      },
      "BondSeriesListItem": {
        "required": [
          "code",
          "type",
          "isin",
          "saleStart",
          "saleEnd",
          "issuePrice",
          "swapPrice",
          "marginPercent",
          "firstPeriodRatePercent"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/TreasuryBondType"
          },
          "isin": {
            "type": "string"
          },
          "saleStart": {
            "type": "string",
            "format": "date"
          },
          "saleEnd": {
            "type": "string",
            "format": "date"
          },
          "issuePrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "swapPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "marginPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "firstPeriodRatePercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "BondSeriesPeriodRateResponse": {
        "required": [
          "periodIndex",
          "ratePercent"
        ],
        "type": "object",
        "properties": {
          "periodIndex": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ratePercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "BondSeriesResponse": {
        "required": [
          "code",
          "type",
          "isin",
          "saleStart",
          "saleEnd",
          "issuePrice",
          "swapPrice",
          "marginPercent",
          "periodRates"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/TreasuryBondType"
          },
          "isin": {
            "type": "string"
          },
          "saleStart": {
            "type": "string",
            "format": "date"
          },
          "saleEnd": {
            "type": "string",
            "format": "date"
          },
          "issuePrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "swapPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "marginPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "periodRates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BondSeriesPeriodRateResponse"
            }
          }
        }
      },
      "CustomInstrumentResponse": {
        "required": [
          "id",
          "ticker",
          "name",
          "source",
          "quoteCurrency",
          "assetClass",
          "verificationStatus"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ticker": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/PriceSource"
          },
          "quoteCurrency": {
            "type": "string"
          },
          "assetClass": {
            "$ref": "#/components/schemas/AssetClass"
          },
          "verificationStatus": {
            "$ref": "#/components/schemas/InstrumentVerificationStatus"
          }
        }
      },
      "InstrumentDetailsResponse": {
        "required": [
          "id",
          "ticker",
          "name",
          "assetClass",
          "quoteCurrency",
          "source",
          "verificationStatus",
          "lastPrice",
          "lastPriceDate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ticker": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "assetClass": {
            "$ref": "#/components/schemas/AssetClass"
          },
          "quoteCurrency": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/PriceSource"
          },
          "verificationStatus": {
            "$ref": "#/components/schemas/InstrumentVerificationStatus"
          },
          "lastPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "lastPriceDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "InstrumentSearchResult": {
        "required": [
          "id",
          "ticker",
          "name",
          "assetClass",
          "quoteCurrency",
          "verificationStatus",
          "lastPrice",
          "lastPriceDate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ticker": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "assetClass": {
            "$ref": "#/components/schemas/AssetClass"
          },
          "quoteCurrency": {
            "type": "string"
          },
          "verificationStatus": {
            "$ref": "#/components/schemas/InstrumentVerificationStatus"
          },
          "lastPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "lastPriceDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "InstrumentVerificationStatus": {
        "type": "integer"
      },
      "Metal": {
        "type": "integer"
      },
      "MetalPriceResponse": {
        "required": [
          "metal",
          "instrumentId",
          "isStale"
        ],
        "type": "object",
        "properties": {
          "metal": {
            "$ref": "#/components/schemas/Metal"
          },
          "instrumentId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "pricePerGramUsd": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "usdPlnRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "pricePerGramPln": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "pricePerTroyOuncePln": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "isStale": {
            "type": "boolean"
          }
        }
      },
      "PriceSource": {
        "type": "integer"
      },
      "SyncRunStatus": {
        "type": "integer"
      },
      "SyncRunSummary": {
        "required": [
          "runId",
          "status",
          "startedAt",
          "syncedCount",
          "noDataCount",
          "failedCount"
        ],
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/SyncRunStatus"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "syncedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "noDataCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "failedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "SyncStatusResponse": {
        "required": [
          "hasRun"
        ],
        "type": "object",
        "properties": {
          "hasRun": {
            "type": "boolean"
          },
          "prices": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SyncRunSummary"
              }
            ]
          },
          "fx": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SyncRunSummary"
              }
            ]
          },
          "backfill": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SyncRunSummary"
              }
            ]
          }
        }
      },
      "TreasuryBondType": {
        "type": "integer"
      }
    }
  },
  "tags": [
    {
      "name": "SearchInstrumentsEndpoint"
    },
    {
      "name": "AddCustomInstrumentEndpoint"
    },
    {
      "name": "GetInstrumentEndpoint"
    },
    {
      "name": "TriggerSyncEndpoint"
    },
    {
      "name": "GetSyncStatusEndpoint"
    },
    {
      "name": "ListBondSeriesEndpoint"
    },
    {
      "name": "GetBondSeriesEndpoint"
    },
    {
      "name": "GetMetalPricesEndpoint"
    }
  ]
}