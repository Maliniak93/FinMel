{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "skarbiec-identity",
    "Audience": "skarbiec",
    "SigningKey": "local-dev-only-signing-key-do-not-use-in-production-0123456789"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-register": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/identity/register/{**catch-all}" }
      },
      "identity-login": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/identity/login/{**catch-all}" }
      },
      "identity-refresh": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/identity/refresh/{**catch-all}" }
      },
      "identity-protected": {
        "ClusterId": "identity-cluster",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "standard",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/identity/{**catch-all}" }
      },
      "identity-openapi": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "standard",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/identity/openapi/{**catch-all}" }
      },
      "portfolio-openapi": {
        "ClusterId": "portfolio-cluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "standard",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/portfolio/openapi/{**catch-all}" }
      },
      "portfolio": {
        "ClusterId": "portfolio-cluster",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "standard",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/portfolio/{**catch-all}" }
      },
      "marketdata-openapi": {
        "ClusterId": "marketdata-cluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "standard",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/marketdata/openapi/{**catch-all}" }
      },
      "marketdata": {
        "ClusterId": "marketdata-cluster",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "standard",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/marketdata/{**catch-all}" }
      },
      "strategy-openapi": {
        "ClusterId": "strategy-cluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "standard",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/strategy/openapi/{**catch-all}" }
      },
      "strategy": {
        "ClusterId": "strategy-cluster",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "standard",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/strategy/{**catch-all}" }
      },
      "reporting-openapi": {
        "ClusterId": "reporting-cluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "standard",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/reporting/openapi/{**catch-all}" }
      },
      "reporting": {
        "ClusterId": "reporting-cluster",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "standard",
        "CorsPolicy": "default",
        "Match": { "Path": "/api/reporting/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://identity-service" }
        }
      },
      "portfolio-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://portfolio-service" }
        }
      },
      "marketdata-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://marketdata-service" }
        }
      },
      "strategy-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://strategy-service" }
        }
      },
      "reporting-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://reporting-service" }
        }
      }
    }
  }
}
