### --- Portfolios ---

### Create a portfolio
# @name createPortfolio
POST {{baseUrl}}/api/portfolio/portfolios
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Main portfolio",
  "description": "Test portfolio created via REST Client",
  "currency": "PLN"
}

### List portfolios
GET {{baseUrl}}/api/portfolio/portfolios?includeArchived=false
Authorization: Bearer {{authToken}}

### Get a portfolio
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}
Authorization: Bearer {{authToken}}

### Update a portfolio
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Main portfolio (renamed)",
  "description": "Updated via REST Client",
  "currency": "PLN"
}

### Archive a portfolio
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/archive
Authorization: Bearer {{authToken}}

### Add an asset to the archived portfolio (409)
# Run right after the archive above. An archived portfolio is read-only: every asset and transaction
# write in it is 409 with errorCode Conflict.PortfolioArchived until it is restored
# (archived-portfolio-out-of-net-worth). Renaming or deleting the portfolio itself still works.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Cash",
  "name": "Cash in an archived portfolio",
  "currency": "PLN"
}

### Restore an archived portfolio
# Mirror of archive: 200 with isArchived=false. Repeating it on a portfolio that is not archived is
# a no-op — still 200, but nothing is published (spec-02).
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/restore
Authorization: Bearer {{authToken}}

### Delete a portfolio
# Cascades: its assets and their transactions are deleted too, and one AssetRemoved per asset
# (CascadedFromPortfolio = true) is published with PortfolioDeleted (spec-08). 204.
DELETE {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}
Authorization: Bearer {{authToken}}


### --- Assets ---

### Add a manual-valuation asset
# @name addAsset
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Cash",
  "name": "Savings account",
  "currency": "PLN",
  "quantity": 1,
  "manualValue": 5000,
  "manualValueDate": "2026-08-18"
}

### Add a market-valuation asset
# @name addMarketAsset
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Stock",
  "name": "Example stock",
  "currency": "USD",
  "quantity": 10,
  "instrumentId": "{{addCustomInstrument.response.body.id}}"
}

### List assets
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets
Authorization: Bearer {{authToken}}

### Get an asset
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}
Authorization: Bearer {{authToken}}

### Update an asset
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Cash",
  "name": "Savings account (renamed)",
  "currency": "PLN",
  "quantity": 1,
  "manualValue": 5200,
  "manualValueDate": "2026-08-18"
}

### Archive an asset
# asset-archive: 200 with isArchived=true. The asset is read-only from now on (409 Conflict.AssetArchived
# on every edit, transaction and deposit write; removal still works) and drops out of net worth from
# today. Repeating it is 200 with the unchanged body. In an archived portfolio: 409 Conflict.PortfolioArchived.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/archive
Authorization: Bearer {{authToken}}

### Update the archived asset (409)
# Run right after the archive above: 409 with errorCode Conflict.AssetArchived.
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Cash",
  "name": "Renamed while archived",
  "currency": "PLN",
  "manualValue": 5200,
  "manualValueDate": "2026-08-18"
}

### Restore an archived asset
# Mirror of archive: 200 with isArchived=false, and the asset counts toward net worth again from today.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/restore
Authorization: Bearer {{authToken}}

### Remove an asset
# Cascades: the asset's transactions are deleted too, and AssetRemoved is published (spec-08). 204.
DELETE {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}
Authorization: Bearer {{authToken}}


### --- Transactions ---

### Record a transaction
# @name recordTransaction
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/transactions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "type": "Deposit",
  "quantity": 1,
  "unitPrice": 5000,
  "date": "2026-08-18"
}

### Record a Buy on the Cash asset (400)
# A Cash or Deposit asset accepts only Deposit/Withdraw transactions: any other type is 400 with
# errorCode Validation.TransactionTypeNotAllowed, and nothing is written (cash-transaction-types).
# The same rule answers AddAsset's initialTransaction, UpdateTransaction, and an UpdateAsset that
# turns an asset holding other types into Cash/Deposit.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/transactions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "type": "Buy",
  "quantity": 1,
  "unitPrice": 100,
  "date": "2026-08-18"
}

### List transactions (paged)
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/transactions?page=1&pageSize=20
Authorization: Bearer {{authToken}}

### Update a transaction
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/transactions/{{recordTransaction.response.body.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "type": "Deposit",
  "quantity": 1,
  "unitPrice": 5200,
  "date": "2026-08-18"
}

### Delete a transaction
DELETE {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/transactions/{{recordTransaction.response.body.id}}
Authorization: Bearer {{authToken}}


### --- Term deposits ---

### Add a term deposit
# Creates the Deposit-class asset (CurrencyValued), its system-managed opening Deposit transaction
# (principal, start date, unit price 1, start-date PLN rate frozen) and its terms in one save, and
# publishes AssetPositionChanged with quantity = principal. 201 with the maturity date, projection
# and status (term-deposits). Enums are ints: termUnit 0 = Days, 1 = Months; capitalization
# 0 = AtMaturity, 1 = Monthly, 2 = Quarterly, 3 = Yearly; status 0 = Active, 1 = Due, 2 = Settled,
# 3 = PaidOut.
# @name addDeposit
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "3-month deposit",
  "bankName": "Example bank",
  "currency": "PLN",
  "principal": 10000.00,
  "startDate": "2026-01-15",
  "termLength": 3,
  "termUnit": 1,
  "annualInterestRatePercent": 6,
  "capitalization": 0,
  "taxExempt": false,
  "earlyBreakInterestLossPercent": 100
}

### Add a Cash account to fund a deposit from
# A currency-valued Cash asset topped up with 5 000 PLN before the deposit's start date.
# @name addFundingCash
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Cash",
  "name": "Current account",
  "currency": "PLN",
  "initialTransaction": {
    "type": "Deposit",
    "quantity": 5000,
    "unitPrice": 1,
    "date": "2026-01-01"
  }
}

### List transfer candidates (the deposit form's sources of funds)
# The user's assets of that class and currency in non-archived portfolios, each with its balance
# (quantity), ordered by portfolio name, then asset name (asset-transfers-deposit-funding).
# assetClass takes the enum name or its int (0 = Cash). 400 for an unsupported currency or a
# missing parameter.
GET {{baseUrl}}/api/portfolio/transfer-candidates?currency=PLN&assetClass=Cash
Authorization: Bearer {{authToken}}

### Add a term deposit funded from cash
# fundingAssetId moves the principal out of that Cash asset as one Cash → Deposit transfer: a
# Withdraw on the Cash and the opening Deposit on the deposit, same amount and start date, linked by
# a shared TransferId; both assets publish AssetPositionChanged in one save. 201 with fundingAssetId
# and fundingAssetName. 400 Validation.InvalidTransferCounterpart for a source that is not the
# user's same-currency Cash in an active portfolio, 400 Validation.InsufficientFunds when the Cash
# can't cover the principal on the start date. The source is fixed at creation; the Cash leg is
# 409 Conflict.TransferLegManaged on PUT/DELETE .../transactions/{id}, and removing either asset
# detaches the other side's leg instead of reversing it.
# @name addFundedDeposit
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Funded deposit",
  "bankName": "Example bank",
  "currency": "PLN",
  "principal": 1000.00,
  "startDate": "2026-01-15",
  "termLength": 3,
  "termUnit": 1,
  "annualInterestRatePercent": 6,
  "capitalization": 0,
  "taxExempt": false,
  "earlyBreakInterestLossPercent": 100,
  "fundingAssetId": "{{addFundingCash.response.body.id}}"
}

### List every deposit across portfolios
# Portfolio name and archived flag, terms, projection and status (Due once the maturity date is on or
# before today's Europe/Warsaw date).
GET {{baseUrl}}/api/portfolio/deposits
Authorization: Bearer {{authToken}}

### Get a deposit
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addDeposit.response.body.assetId}}
Authorization: Bearer {{authToken}}

### Update a deposit
# Same fields as add, minus the currency and the funding source (both immutable). Rewrites the
# opening transaction in place and publishes AssetPositionChanged with the new quantity. On a funded
# deposit a new principal or start date rewrites both transfer legs and publishes for both assets
# (400 Validation.InsufficientFunds when the Cash can't cover it, 409 Conflict.PortfolioArchived when
# the Cash's portfolio is archived).
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addDeposit.response.body.assetId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "6-month deposit",
  "bankName": "Example bank",
  "principal": 15000.00,
  "startDate": "2026-02-01",
  "termLength": 6,
  "termUnit": 1,
  "annualInterestRatePercent": 5.5,
  "capitalization": 2,
  "taxExempt": false,
  "earlyBreakInterestLossPercent": 100
}

### Record a transaction on the deposit (409)
# A term deposit's transactions are system-managed: recording, editing or deleting one is 409 with
# errorCode Conflict.DepositTransactionsManaged. Creating or editing a Deposit-class asset through
# .../assets is 400 Validation.UseDepositEndpoints. Delete the deposit with DELETE .../assets/{id}.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addDeposit.response.body.assetId}}/transactions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "type": 2,
  "quantity": 500,
  "unitPrice": 1,
  "date": "2026-02-01"
}

### Preview the settlement of a Due deposit
# The part-1 projection (gross, tax, net, final amount) with settledOn defaulting to the maturity
# date — what the settle dialog is pre-filled with (term-deposits-settlement). 409
# Conflict.DepositNotDue before the maturity date (Europe/Warsaw), 409 Conflict.DepositAlreadySettled
# once settled. The deposit updated above matures on 2026-08-01.
# @name settlementPreview
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addDeposit.response.body.assetId}}/settlement-preview
Authorization: Bearer {{authToken}}

### Settle the deposit
# What the bank actually paid — here the previewed values; override them when the bank paid
# something else. 400 unless grossInterest >= 0, 0 <= tax <= grossInterest and
# startDate <= settledOn <= today. Stores the settlement, adds a system-managed Deposit transaction of
# the net interest (gross - tax, none when 0) on settledOn with that date's PLN rate frozen, raises
# the quantity to principal + net and publishes AssetPositionChanged, all in one save. 200 with the
# deposit, now Settled. A settled deposit's terms are immutable: updating it is 409
# Conflict.DepositSettled; deleting it (DELETE .../assets/{id}) stays allowed.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addDeposit.response.body.assetId}}/settle
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "settledOn": "{{settlementPreview.response.body.settledOn}}",
  "grossInterest": {{settlementPreview.response.body.grossInterest}},
  "tax": {{settlementPreview.response.body.tax}}
}

### Pay the settled deposit out to cash
# Moves the deposit's whole balance (principal + net) to a Cash asset as one Deposit → Cash transfer on
# date: a Withdraw on the deposit linked to a Deposit on the Cash, the deposit's quantity becomes 0,
# and both assets publish AssetPositionChanged in one save (deposit-payout-to-cash). 200 with the
# deposit, now PaidOut, with paidOutOn and paidOutToAssetName. 400 unless settledOn <= date <= today
# (Europe/Warsaw); 400 Validation.InvalidTransferCounterpart for a destination that is not the user's
# same-currency Cash in an active portfolio; 409 Conflict.DepositNotSettled for an Active or Due
# deposit, 409 Conflict.DepositAlreadyPaidOut once paid out, 409 Conflict.PortfolioArchived.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addDeposit.response.body.assetId}}/payout
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "destinationAssetId": "{{addFundingCash.response.body.id}}",
  "date": "{{settlementPreview.response.body.settledOn}}"
}

### Preview the settlement of the funded deposit
# The funded deposit above matures on 2026-04-15.
# @name fundedSettlementPreview
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addFundedDeposit.response.body.assetId}}/settlement-preview
Authorization: Bearer {{authToken}}

### Settle the funded deposit and pay it out at once
# destinationAssetId pays the whole balance out in the same save as the settlement, on settledOn:
# the deposit holds 0 and is PaidOut, the Cash rises by principal + net. A destination that breaks the
# transfer rules is 400 Validation.InvalidTransferCounterpart and the deposit is not settled either.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addFundedDeposit.response.body.assetId}}/settle
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "settledOn": "{{fundedSettlementPreview.response.body.settledOn}}",
  "grossInterest": {{fundedSettlementPreview.response.body.grossInterest}},
  "tax": {{fundedSettlementPreview.response.body.tax}},
  "destinationAssetId": "{{addFundingCash.response.body.id}}"
}

### Add a matured deposit to roll over
# 10 000 PLN at 6 % for 3 months from 2026-01-15 — Due since its 2026-04-15 maturity.
# @name addRenewableDeposit
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Renewable deposit",
  "bankName": "Example bank",
  "currency": "PLN",
  "principal": 10000.00,
  "startDate": "2026-01-15",
  "termLength": 3,
  "termUnit": 1,
  "annualInterestRatePercent": 6,
  "capitalization": 0,
  "taxExempt": false,
  "earlyBreakInterestLossPercent": 100
}

### Preview the settlement of the renewable deposit
# @name renewablePreview
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addRenewableDeposit.response.body.assetId}}/settlement-preview
Authorization: Bearer {{authToken}}

### Roll the Due deposit over
# Settles it and starts the next term on the same asset in one save (deposit-rollover): the net
# interest (gross - tax, none when 0) is credited on the old maturity date with that date's PLN rate
# frozen, the new principal is the whole balance (principal + net), the new start date the old
# maturity date, the maturity date is recomputed from the unchanged term, and only the rate changes.
# The settlement fields are cleared, rolloverCount goes up by 1 and AssetPositionChanged is
# published. 200 with the deposit — Active, or Due at once when the new maturity date is already past.
# grossInterest and tax are required here (400 Validation.SettlementAmountsRequired), with the settle
# rules; 409 Conflict.DepositNotDue before the maturity date, 409 Conflict.DepositAlreadyPaidOut once
# paid out, 409 Conflict.PortfolioArchived. Once rolled over, PUT .../deposits/{id} with another
# principal or start date is 409 Conflict.DepositRolledOver; every other term stays editable.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addRenewableDeposit.response.body.assetId}}/rollover
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "annualInterestRatePercent": 5.5,
  "grossInterest": {{renewablePreview.response.body.grossInterest}},
  "tax": {{renewablePreview.response.body.tax}}
}

### Preview the settlement of the rolled-over term
# The next term runs 2026-04-15 → 2026-07-15 on the whole balance, so it is Due again once that passes.
# @name renewedPreview
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addRenewableDeposit.response.body.assetId}}/settlement-preview
Authorization: Bearer {{authToken}}

### Settle the rolled-over term, keeping the money in the deposit
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addRenewableDeposit.response.body.assetId}}/settle
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "settledOn": "{{renewedPreview.response.body.settledOn}}",
  "grossInterest": {{renewedPreview.response.body.grossInterest}},
  "tax": {{renewedPreview.response.body.tax}}
}

### Roll the Settled deposit over
# A Settled deposit that was not paid out reuses its stored settlement: send the rate alone —
# grossInterest or tax is 409 Conflict.DepositAlreadySettled. The new principal is principal + the
# settled net and the new start date the old maturity date (not the settlement date); no transaction
# is written and no event is published, as the quantity is unchanged. rolloverCount becomes 2.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addRenewableDeposit.response.body.assetId}}/rollover
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "annualInterestRatePercent": 5
}
