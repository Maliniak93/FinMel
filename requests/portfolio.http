  "grossInterest": {{savingsInterestPreview.response.body.grossInterest}},
  "tax": {{savingsInterestPreview.response.body.tax}}
}

### Undo the latest interest settlement
DELETE {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/savings-accounts/{{addSavingsAccount.response.body.assetId}}/interest-settlements/{{settleSavingsInterest.response.body.settlementId}}
Authorization: Bearer {{authToken}}

### --- Transfers between cash and savings ---

### Transfer cash into the savings account
# @name createTransfer
POST {{baseUrl}}/api/portfolio/transfers
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "sourceAssetId": "{{addFundingCash.response.body.id}}",
  "targetAssetId": "{{addSavingsAccount.response.body.assetId}}",
  "amount": 500.00,
  "date": "2026-02-02"
}

### Delete the transfer
DELETE {{baseUrl}}/api/portfolio/transfers/{{createTransfer.response.body.transferId}}
Authorization: Bearer {{authToken}}

### --- Paying a deposit out into a savings account ---

### Add a matured deposit to pay out into savings
# @name addSavingsBoundDeposit
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Deposit for savings",
  "bankName": "Example bank",
  "currency": "PLN",
  "principal": 10000.00,
  "startDate": "2026-01-15",
  "termLength": 3,
  "termUnit": 1,
  "annualInterestRatePercent": 6,
  "capitalization": 0,
  "taxExempt": false,
  "earlyBreakInterestLossPercent": 100
}

### Preview the settlement of the deposit bound for savings
# @name savingsBoundPreview
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addSavingsBoundDeposit.response.body.assetId}}/settlement-preview
Authorization: Bearer {{authToken}}

### Settle the deposit and pay it out into the savings account
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addSavingsBoundDeposit.response.body.assetId}}/settle
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "settledOn": "{{savingsBoundPreview.response.body.settledOn}}",
  "grossInterest": {{savingsBoundPreview.response.body.grossInterest}},
  "tax": {{savingsBoundPreview.response.body.tax}},
  "destinationAssetId": "{{addSavingsAccount.response.body.assetId}}"
}
