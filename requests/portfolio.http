### --- Portfolios ---

### Create a portfolio
# @name createPortfolio
POST {{baseUrl}}/api/portfolio/portfolios
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Main portfolio",
  "description": "Test portfolio created via REST Client",
  "currency": "PLN"
}

### List portfolios
GET {{baseUrl}}/api/portfolio/portfolios?includeArchived=false
Authorization: Bearer {{authToken}}

### Get a portfolio
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}
Authorization: Bearer {{authToken}}

### Update a portfolio
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Main portfolio (renamed)",
  "description": "Updated via REST Client",
  "currency": "PLN"
}

### Archive a portfolio
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/archive
Authorization: Bearer {{authToken}}

### Add an asset to the archived portfolio (409)
# Run right after the archive above.
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Cash",
  "name": "Cash in an archived portfolio",
  "currency": "PLN"
}

### Restore an archived portfolio
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/restore
Authorization: Bearer {{authToken}}

### Delete a portfolio
DELETE {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}
Authorization: Bearer {{authToken}}


### --- Assets ---

### Add a manual-valuation asset
# @name addAsset
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Cash",
  "name": "Savings account",
  "currency": "PLN",
  "quantity": 1,
  "manualValue": 5000,
  "manualValueDate": "2026-08-18"
}

### Add a market-valuation asset
# @name addMarketAsset
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Stock",
  "name": "Example stock",
  "currency": "USD",
  "quantity": 10,
  "instrumentId": "{{addCustomInstrument.response.body.id}}"
}

### List assets
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets
Authorization: Bearer {{authToken}}

### Get an asset
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}
Authorization: Bearer {{authToken}}

### Update an asset
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Cash",
  "name": "Savings account (renamed)",
  "currency": "PLN",
  "quantity": 1,
  "manualValue": 5200,
  "manualValueDate": "2026-08-18"
}

### Archive an asset
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/archive
Authorization: Bearer {{authToken}}

### Update the archived asset (409)
# Run right after the archive above.
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Cash",
  "name": "Renamed while archived",
  "currency": "PLN",
  "manualValue": 5200,
  "manualValueDate": "2026-08-18"
}

### Restore an archived asset
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/restore
Authorization: Bearer {{authToken}}

### Remove an asset
DELETE {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}
Authorization: Bearer {{authToken}}


### --- Transactions ---

### Record a transaction
# @name recordTransaction
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/transactions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "type": "Deposit",
  "quantity": 1,
  "unitPrice": 5000,
  "date": "2026-08-18"
}

### Record a Buy on the Cash asset (400)
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/transactions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "type": "Buy",
  "quantity": 1,
  "unitPrice": 100,
  "date": "2026-08-18"
}

### List transactions (paged)
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/transactions?page=1&pageSize=20
Authorization: Bearer {{authToken}}

### Update a transaction
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/transactions/{{recordTransaction.response.body.id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "type": "Deposit",
  "quantity": 1,
  "unitPrice": 5200,
  "date": "2026-08-18"
}

### Delete a transaction
DELETE {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addAsset.response.body.id}}/transactions/{{recordTransaction.response.body.id}}
Authorization: Bearer {{authToken}}


### --- Term deposits ---

### Add a term deposit
# @name addDeposit
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "3-month deposit",
  "bankName": "Example bank",
  "currency": "PLN",
  "principal": 10000.00,
  "startDate": "2026-01-15",
  "termLength": 3,
  "termUnit": 1,
  "annualInterestRatePercent": 6,
  "capitalization": 0,
  "taxExempt": false,
  "earlyBreakInterestLossPercent": 100
}

### Add a Cash account to fund a deposit from
# @name addFundingCash
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "assetClass": "Cash",
  "name": "Current account",
  "currency": "PLN",
  "initialTransaction": {
    "type": "Deposit",
    "quantity": 5000,
    "unitPrice": 1,
    "date": "2026-01-01"
  }
}

### List transfer candidates (the deposit form's sources of funds)
GET {{baseUrl}}/api/portfolio/transfer-candidates?currency=PLN&assetClass=Cash
Authorization: Bearer {{authToken}}

### Add a term deposit funded from cash
# @name addFundedDeposit
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Funded deposit",
  "bankName": "Example bank",
  "currency": "PLN",
  "principal": 1000.00,
  "startDate": "2026-01-15",
  "termLength": 3,
  "termUnit": 1,
  "annualInterestRatePercent": 6,
  "capitalization": 0,
  "taxExempt": false,
  "earlyBreakInterestLossPercent": 100,
  "fundingAssetId": "{{addFundingCash.response.body.id}}"
}

### List every deposit across portfolios
GET {{baseUrl}}/api/portfolio/deposits
Authorization: Bearer {{authToken}}

### Get a deposit
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addDeposit.response.body.assetId}}
Authorization: Bearer {{authToken}}

### Update a deposit
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addDeposit.response.body.assetId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "6-month deposit",
  "bankName": "Example bank",
  "principal": 15000.00,
  "startDate": "2026-02-01",
  "termLength": 6,
  "termUnit": 1,
  "annualInterestRatePercent": 5.5,
  "capitalization": 2,
  "taxExempt": false,
  "earlyBreakInterestLossPercent": 100
}

### Record a transaction on the deposit (409)
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addDeposit.response.body.assetId}}/transactions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "type": 2,
  "quantity": 500,
  "unitPrice": 1,
  "date": "2026-02-01"
}

### Preview the settlement of a Due deposit
# @name settlementPreview
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addDeposit.response.body.assetId}}/settlement-preview
Authorization: Bearer {{authToken}}

### Settle the deposit
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addDeposit.response.body.assetId}}/settle
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "settledOn": "{{settlementPreview.response.body.settledOn}}",
  "grossInterest": {{settlementPreview.response.body.grossInterest}},
  "tax": {{settlementPreview.response.body.tax}}
}

### Pay the settled deposit out to cash
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addDeposit.response.body.assetId}}/payout
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "destinationAssetId": "{{addFundingCash.response.body.id}}",
  "date": "{{settlementPreview.response.body.settledOn}}"
}

### Preview the settlement of the funded deposit
# @name fundedSettlementPreview
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addFundedDeposit.response.body.assetId}}/settlement-preview
Authorization: Bearer {{authToken}}

### Settle the funded deposit and pay it out at once
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addFundedDeposit.response.body.assetId}}/settle
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "settledOn": "{{fundedSettlementPreview.response.body.settledOn}}",
  "grossInterest": {{fundedSettlementPreview.response.body.grossInterest}},
  "tax": {{fundedSettlementPreview.response.body.tax}},
  "destinationAssetId": "{{addFundingCash.response.body.id}}"
}

### Add a matured deposit to roll over
# @name addRenewableDeposit
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Renewable deposit",
  "bankName": "Example bank",
  "currency": "PLN",
  "principal": 10000.00,
  "startDate": "2026-01-15",
  "termLength": 3,
  "termUnit": 1,
  "annualInterestRatePercent": 6,
  "capitalization": 0,
  "taxExempt": false,
  "earlyBreakInterestLossPercent": 100
}

### Preview the settlement of the renewable deposit
# @name renewablePreview
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addRenewableDeposit.response.body.assetId}}/settlement-preview
Authorization: Bearer {{authToken}}

### Roll the Due deposit over
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addRenewableDeposit.response.body.assetId}}/rollover
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "annualInterestRatePercent": 5.5,
  "grossInterest": {{renewablePreview.response.body.grossInterest}},
  "tax": {{renewablePreview.response.body.tax}}
}

### Preview the settlement of the rolled-over term
# @name renewedPreview
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addRenewableDeposit.response.body.assetId}}/settlement-preview
Authorization: Bearer {{authToken}}

### Settle the rolled-over term, keeping the money in the deposit
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addRenewableDeposit.response.body.assetId}}/settle
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "settledOn": "{{renewedPreview.response.body.settledOn}}",
  "grossInterest": {{renewedPreview.response.body.grossInterest}},
  "tax": {{renewedPreview.response.body.tax}}
}

### Roll the Settled deposit over
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/deposits/{{addRenewableDeposit.response.body.assetId}}/rollover
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "annualInterestRatePercent": 5
}

### --- Treasury bonds ---

### Add a treasury bond bought with new money (type 5 = EDO)
# @name addBond
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "EDO1036",
  "seriesCode": "EDO1036",
  "type": 5,
  "purchaseDate": "2026-10-01",
  "bondCount": 50,
  "purchasePricePerBond": 100.00,
  "firstPeriodRatePercent": 5.35,
  "marginPercent": 2.00,
  "earlyRedemptionFeePerBond": 3.00,
  "taxExempt": false
}

### Add a treasury bond funded from cash (type 1 = ROR)
# @name addFundedBond
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "ROR0627",
  "seriesCode": "ROR0627",
  "type": 1,
  "purchaseDate": "2026-06-10",
  "bondCount": 10,
  "purchasePricePerBond": 100.00,
  "firstPeriodRatePercent": 4.25,
  "earlyRedemptionFeePerBond": 0.50,
  "taxExempt": false,
  "fundingAssetId": "{{addFundingCash.response.body.id}}"
}

### List every bond across portfolios — each with estimate {grossValue, netValue, asOf} or null and estimateUnavailableReason (RateMissing | MarketDataUnavailable)
GET {{baseUrl}}/api/portfolio/bonds
Authorization: Bearer {{authToken}}

### Get a bond
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addBond.response.body.assetId}}
Authorization: Bearer {{authToken}}

### Update a bond
PUT {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addBond.response.body.assetId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "EDO1036 (IKE)",
  "seriesCode": "EDO1036",
  "type": 5,
  "purchaseDate": "2026-10-01",
  "bondCount": 60,
  "purchasePricePerBond": 100.00,
  "firstPeriodRatePercent": 5.35,
  "marginPercent": 2.00,
  "earlyRedemptionFeePerBond": 3.00,
  "taxExempt": true
}

### Record a transaction on the bond (409)
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/assets/{{addBond.response.body.assetId}}/transactions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "type": 2,
  "quantity": 500,
  "unitPrice": 1,
  "date": "2026-10-01"
}

### Preview the funded ROR's three due months (period 1 takes the rate from the terms)
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addFundedBond.response.body.assetId}}/interest-settlements/preview
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "periods": [
    { "periodIndex": 1 },
    { "periodIndex": 2, "ratePercent": 3.75 },
    { "periodIndex": 3, "ratePercent": 3.75 }
  ],
  "destinationAssetId": "{{addFundingCash.response.body.id}}"
}

### Settle them: each net coupon is credited and moved Bond → Cash on its period end
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addFundedBond.response.body.assetId}}/interest-settlements
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "periods": [
    { "periodIndex": 1 },
    { "periodIndex": 2, "ratePercent": 3.75 },
    { "periodIndex": 3, "ratePercent": 3.75 }
  ],
  "destinationAssetId": "{{addFundingCash.response.body.id}}"
}

### Get the funded ROR: settled periods, duePeriodCount and lastSettlement
# @name getFundedBond
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addFundedBond.response.body.assetId}}
Authorization: Bearer {{authToken}}

### Undo the latest settlement (only the latest can be undone)
DELETE {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addFundedBond.response.body.assetId}}/interest-settlements/{{getFundedBond.response.body.lastSettlement.settlementId}}
Authorization: Bearer {{authToken}}

### Preview redeeming 4 of the funded ROR's 10 early, inside month 3 (months 1–2 stay settled after the undo)
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addFundedBond.response.body.assetId}}/early-redemption-preview?date=2026-09-05&bondCount=4&runningPeriodRatePercent=3.75
Authorization: Bearer {{authToken}}

### Redeem them early: accrued interest credited, the full fee and Belka tax charged, the proceeds moved Bond → Cash; 6 bonds remain
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addFundedBond.response.body.assetId}}/early-redemption
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "date": "2026-09-05",
  "bondCount": 4,
  "runningPeriodRatePercent": 3.75,
  "destinationAssetId": "{{addFundingCash.response.body.id}}"
}

### Add a matured 3-month bond funded from cash (type 0 = OTS)
# @name addMaturedBond
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "OTS0926",
  "seriesCode": "OTS0926",
  "type": 0,
  "purchaseDate": "2026-06-01",
  "bondCount": 10,
  "purchasePricePerBond": 100.00,
  "firstPeriodRatePercent": 3.00,
  "earlyRedemptionFeePerBond": 0.00,
  "taxExempt": false,
  "fundingAssetId": "{{addFundingCash.response.body.id}}"
}

### Settle its only period: the interest is capitalised into the bond
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addMaturedBond.response.body.assetId}}/interest-settlements
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "periods": [
    { "periodIndex": 1 }
  ]
}

### Preview its redemption: capitalised interest, discount, Belka tax and proceeds, all dated the maturity date
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addMaturedBond.response.body.assetId}}/redemption-preview
Authorization: Bearer {{authToken}}

### Swap 6 of the 10 into EDO1036 at the swap price; the rest of the proceeds goes to the cash (send the redemption below instead to pay everything out)
# @name swapBond
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addMaturedBond.response.body.assetId}}/swap
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "bondCount": 6,
  "newBond": {
    "name": "EDO0936",
    "seriesCode": "EDO0936",
    "type": 5,
    "swapPricePerBond": 99.90,
    "firstPeriodRatePercent": 5.35,
    "marginPercent": 2.00,
    "earlyRedemptionFeePerBond": 3.00
  },
  "destinationAssetId": "{{addFundingCash.response.body.id}}"
}

### Redeem the whole holding to cash instead (409 once it was swapped)
POST {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addMaturedBond.response.body.assetId}}/redemption
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "destinationAssetId": "{{addFundingCash.response.body.id}}"
}

### Get the redeemed bond: status Redeemed, its redemption and the swap target's name
GET {{baseUrl}}/api/portfolio/portfolios/{{createPortfolio.response.body.id}}/bonds/{{addMaturedBond.response.body.assetId}}
Authorization: Bearer {{authToken}}

