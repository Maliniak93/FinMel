@authToken = {{login.response.body.accessToken}}

### Login
# @name login
POST {{baseUrl}}/api/identity/login
Content-Type: application/json

{
  "email": "test@skarbiec.local",
  "password": "P@ssw0rd!123"
}

### Search instruments
GET {{baseUrl}}/api/marketdata/instruments/search?q=CDR&limit=20
Authorization: Bearer {{authToken}}

### Search ETFs — local matches plus Yahoo listings on the configured exchanges; { results, providerUnavailable }
GET {{baseUrl}}/api/marketdata/instruments/search?q=vanguard%20all-world&assetClass=Etf&limit=20
Authorization: Bearer {{authToken}}

### Add a custom instrument — exchange and currency come from the ticker suffix; a known ticker answers 200 with the stored one
# @name addCustomInstrument
POST {{baseUrl}}/api/marketdata/instruments
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "ticker": "PKO.WA",
  "name": "PKO Bank Polski",
  "assetClass": "Stock"
}

### Get instrument details
GET {{baseUrl}}/api/marketdata/instruments/{{addCustomInstrument.response.body.id}}
Authorization: Bearer {{authToken}}

### Trigger a price sync
POST {{baseUrl}}/api/marketdata/sync/trigger
Authorization: Bearer {{authToken}}

### Get sync status — the latest run per kind: { hasRun, prices?, fx?, backfill? }
GET {{baseUrl}}/api/marketdata/sync/status
Authorization: Bearer {{authToken}}

### Latest gold and silver spot prices per gram in USD and PLN — null prices for a metal with no quote yet
GET {{baseUrl}}/api/marketdata/metal-prices
Authorization: Bearer {{authToken}}

### List the treasury bond series on sale on a date — omit onSaleOn for today in Warsaw
GET {{baseUrl}}/api/marketdata/bond-series?onSaleOn=2026-10-15
Authorization: Bearer {{authToken}}

### Get a treasury bond series with every published period rate; 404 NotFound.BondSeries for an unknown code
GET {{baseUrl}}/api/marketdata/bond-series/ROR0623
Authorization: Bearer {{authToken}}


### --- Service-only /internal endpoints ---
# Unreachable through the Gateway: call MarketData directly, with no token.
@marketDataUrl = https://localhost:60587

### Get instrument details (Portfolio's instrument lookup)
GET {{marketDataUrl}}/internal/instruments/{{addCustomInstrument.response.body.id}}

### Get FX rate (Portfolio's transaction-date rate lookup) — the latest EURPLN rate on or before the date; 404 when there is none
GET {{marketDataUrl}}/internal/fx/EUR/rate?date=2026-08-18

### Latest prices batch
POST {{marketDataUrl}}/internal/prices/latest-batch
Content-Type: application/json

{
  "instrumentIds": ["{{addCustomInstrument.response.body.id}}"],
  "asOfDate": "2026-08-18"
}

### Instruments batch (Portfolio's securities list) — ticker, name, exchange, quote currency and the latest close on or before today; unknown ids are skipped
POST {{marketDataUrl}}/internal/instruments/batch
Content-Type: application/json

{
  "instrumentIds": ["{{addCustomInstrument.response.body.id}}"]
}

### Latest FX rates batch
POST {{marketDataUrl}}/internal/fx/latest-batch
Content-Type: application/json

{
  "pairs": ["USDPLN", "EURPLN"],
  "asOfDate": "2026-08-18"
}

### Bond series rates batch (Portfolio's value-today estimate) — zero-based periodIndex; unknown codes are skipped
POST {{marketDataUrl}}/internal/bond-series/rates-batch
Content-Type: application/json

{
  "codes": ["EDO1035", "ROR0623"]
}
